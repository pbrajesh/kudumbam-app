# Copy to server/.env (not committed) and fill in.

# PostgreSQL connection. For local development without installing PostgreSQL, run `npm run db:dev`
# in another terminal and keep this value (it starts PGlite, an embedded Postgres, on port 54329).
DATABASE_URL=postgres://postgres:postgres@localhost:54329/postgres
# PGlite serves one session at a time, so keep the pool at 1 with db:dev. Remove for a real PostgreSQL server.
PG_POOL_MAX=1

# Your Supabase project URL (Project Settings → API). Only used to check sign-in tokens; no Supabase secret needed.
SUPABASE_URL=https://your-project-ref.supabase.co

# Browser origins allowed to call this API, comma separated. Leave empty when the app reaches the API through
# the Angular dev proxy or the same domain. Example for production: https://family.example.com
CORS_ORIGINS=

PORT=3000

# Anyone who signs in can start a family tree; this caps how many one account can start.
MAX_TREES_PER_USER=5
# Members (joined or invited) per tree, and people per tree.
MAX_MEMBERS_PER_TREE=200
MAX_PEOPLE_PER_TREE=20000

# Behind a hosting proxy (Render, Railway, Fly, a load balancer…) set this to 1 so rate limits see each visitor's
# own IP address instead of the proxy's. Leave empty when nothing sits in front of the API.
TRUST_PROXY=
